# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/cafe_pos

# JWT
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRY=8h

# CORS
FRONTEND_URL=http://localhost:5173

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret

# Mailtrap
MAILTRAP_TOKEN=Your_Mailtrap_API_Token_Here
# Set true for Mailtrap Email Sandbox. Leave false for verified-domain sending.
MAILTRAP_USE_SANDBOX=false
# Required only when MAILTRAP_USE_SANDBOX=true.
MAILTRAP_INBOX_ID=
EMAIL_FROM=noreply@odoocafedemo.com

# App
CAFE_NAME=Odoo Cafe
